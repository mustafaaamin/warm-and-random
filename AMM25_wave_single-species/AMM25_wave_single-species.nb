       RowBox[{"Tc", "=", "Tfsc"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"~~", "~~", "~~", "~~", 
         RowBox[{"Picard", " ", "Iteration"}], "~~", "~~", "~~", "~~"}], 
