              RowBox[{"(", 
               FractionBox["ks", 
                RowBox[{"aeq", " ", "m"}]], ")"}], "2"], " ", 
             SuperscriptBox["F", "2"]}], "]"}]}], ")"}], "*", "mask"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Tfsc", "=", 
        RowBox[{
         RowBox[{"(", 
