     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "Tfsa", ",", "Tfsb", ",", "Tfsc", ",", "KK", ",", "Ta", ",", "Tb", ",",
         "Tc"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"~~", "~~", "~~", "~~", 
        RowBox[{
         RowBox[{"~", "Free"}], "-", 
         RowBox[{"streaming", " ", "Kernels"}]}], " ", "~~", "~~", "~~", 
        "~~"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Tfsa", "=", 
        RowBox[{
         RowBox[{"Cos", "[", 
          RowBox[{
           FractionBox[
            SuperscriptBox["k", "2"], 
            RowBox[{
             SqrtBox["2"], " ", "aeq", " ", "keq", " ", "m"}]], "F"}], "]"}], 
         
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox[
             RowBox[{"(", 
              FractionBox["k", "keq"], ")"}], "2"]}], 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox["ks", 
              RowBox[{"aeq", " ", "m"}]], ")"}], "2"], " ", 
           SuperscriptBox["F", "2"]}], "]"}], "*", "mask"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Tfsb", "=", 
        RowBox[{"F", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sinc", "[", 
            RowBox[{
             FractionBox[
              SuperscriptBox["k", "2"], 
