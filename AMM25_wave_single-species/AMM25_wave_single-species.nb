      RowBox[{
       RowBox[{"Most", "[", "ygrid", "]"}], "*", 
       RowBox[{"Rest", "[", "ygrid", "]"}]}]]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["m", "i"], "=", 
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{
          SubscriptBox["y", 
           RowBox[{"i", "+", "1"}]], 
          SubscriptBox["y", "i"]}]], " ", "of", " ", "y"}], "-", "grid"}]}], 
     ",", 
     RowBox[{"useful", " ", "for", " ", "integration"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["y", 
         RowBox[{"i", "+", "1"}]], "-", 
        SubscriptBox["y", "i"]}], ")"}], "=", 
      RowBox[{
       SubscriptBox["y", "i"], "r"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Nmid", "=", 
     RowBox[{"Length", "[", "midpts", "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"#", " ", "of", " ", "y", " ", "midpoints"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"klist", "=", 
     RowBox[{"Exp", "@", 
      RowBox[{"Subdivide", "[", 
       RowBox[{
        RowBox[{"Log", "[", "kmin", "]"}], ",", 
        RowBox[{"Log", "[", "kmax", "]"}], ",", 
        RowBox[{"Nk", "-", "1"}]}], "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"k", "-", "grid"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Precompute", " ", "k"}], "-", 
     RowBox[{"independent", " ", "matrices"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F", "=", 
     RowBox[{"Outer", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{
          FractionBox["#1", "#2"], " ", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              SqrtBox[
               RowBox[{"1", "+", "#2"}]]}], ")"}], "2"], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              SqrtBox[
               RowBox[{"1", "+", "#1"}]]}], ")"}], "2"]]}], "]"}], "&"}], ",",
        "midpts", ",", "midpts"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "distance", " ", "function", " ", "as", " ", "a", " ", "matrix", " ", 
     "of", " ", "y", " ", "and", " ", 
     RowBox[{"y", "'"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DY", "=", 
     RowBox[{"Outer", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#2", " ", "r"}], ")"}], "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "+", "#2"}], "]"}]}], "&"}], ",", "midpts", ",", 
       "midpts"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "integration", " ", "measure", " ", "as", " ", "a", " ", "vector"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mask", "=", 
     RowBox[{"LowerTriangularize", "[", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{"1.", ",", 
         RowBox[{"{", 
          RowBox[{"Nmid", ",", "Nmid"}], "}"}]}], "]"}], ",", 
       RowBox[{"-", "1"}]}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"y", ">", 
     RowBox[{"y", "'"}]}], " ", "*)"}], "\[IndentingNewLine]", "\n", 
   StyleBox[
    RowBox[{"(*", 
     RowBox[{"~~", "~~", 
      RowBox[{
       RowBox[{"~", " ", "main"}], " ", "module"}], " ", "~~", "~~", "~~"}], 
     "*)"}], "Subsection"], "\[IndentingNewLine]", 
   RowBox[{"ClearAll", "[", "computeT", "]"}], "\n", 
   RowBox[{
    RowBox[{"computeT", "[", 
     RowBox[{"k_", ",", "Nit_", ",", "F_", ",", "DY_", ",", "mask_"}], "]"}], 
    ":=", 
