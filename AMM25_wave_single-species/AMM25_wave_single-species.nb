Cell[CellGroupData[{
Cell["\<\
Volterra  Solvers  and  Power  Spectra -- waves, single species.\
\>", "Title",
 CellChangeTimes->{{3.963047646739142*^9, 3.963047649951182*^9}, {
  3.9632137151202397`*^9, 3.963213734373407*^9}, {3.982682993442918*^9, 
  3.9826829989458103`*^9}},ExpressionUUID->"a7924895-5ac1-4b3e-b1df-\
70e4d1f2a670"],

Cell[TextData[{
 " Created 2025.\nLast edited March 2026.\n Email mustafa.a.amin@rice.edu if \
you have questions or corrections.\n \nPlease cite the following depending on \
your usage:\nFor particle-like DM with Warmth and Poisson :\[LineSeparator]",
 "- single species  Amin, Delos & Mirbabayi \
(2025)[https://arxiv.org/abs/2503.20881]. Also includes N-body simulations. \
More general code also available.",
 "\[LineSeparator]- multi-species, Amin, Delos & Yang (2025) \
[https://arxiv.org/abs/2510.15046]. Also includes (limited) N-body \
simulations.\nFor Wave DM with Warmth and Poisson:\n",
 StyleBox["- single species,  Amin, May & Mirbabayi (2025) \
[https://arxiv.org/abs/2506.12131]. Includes nonlinear Schrodinger-Poisson \
simulations.",
  FontWeight->"Bold"],
 "\n- multi-species,   Amin & Delos (2025) \
[https://arxiv.org/abs/2510.17977]. Most general, can include the particle \
case also."
}], "Text",
 CellChangeTimes->{{3.969609142859744*^9, 3.969609239858501*^9}, {
