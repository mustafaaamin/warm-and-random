Cell[CellGroupData[{

Cell["Power Spectrum Evolution", "Section",
 CellChangeTimes->{{3.96322306151667*^9, 3.963223071175539*^9}, {
  3.963223101361438*^9, 3.963223112006201*^9}, {3.963491856973289*^9, 
  3.963491858018205*^9}, {3.9737535848073597`*^9, 
  3.973753603493297*^9}},ExpressionUUID->"7b99510d-b181-432a-a9b6-\
993b46e72a76"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  StyleBox["\[IndentingNewLine]", "Subsection"], 
  StyleBox["\[IndentingNewLine]", "Subsection"], 
  StyleBox[
   RowBox[{"(*", 
    RowBox[{"~~", "~~", "~~", 
     RowBox[{
      RowBox[{"~", " ", "Power"}], " ", "Spectrum", " ", "Evolution"}], " ", "~~",
      "~~", "~~", "~"}], "*)"}], "Subsection"], 
  StyleBox["\[IndentingNewLine]", "Subsection"], 
  StyleBox["\[IndentingNewLine]", "Subsection"], 
  StyleBox["\[IndentingNewLine]", "Subsection"], 
  StyleBox[
   RowBox[{"(*", " ", 
    RowBox[{"setting", " ", "up", " ", "initial", " ", "conditions"}], " ", 
    "*)"}], "Subsection",
   FontSize->16], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dy", "=", 
     FractionBox[
      RowBox[{"r", " ", "midpts"}], 
      SqrtBox[
       RowBox[{"1", "+", "midpts"}]]]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"integration", " ", "measure"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kk", "=", "klist"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"extract", " ", "k", " ", "values"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PisoIn", "[", "j_", "]"}], ":=", 
     RowBox[{
      FractionBox[
       SuperscriptBox[
        RowBox[{"kk", "[", 
         RowBox[{"[", "j", "]"}], "]"}], "3"], 
       RowBox[{"2", 
        SuperscriptBox["\[Pi]", "2"]}]], 
      FractionBox[
       SuperscriptBox["\[Pi]", 
        RowBox[{"3", "/", "2"}]], 
       SuperscriptBox["ks", "3"]], 
      SuperscriptBox["E", 
       FractionBox[
        RowBox[{"-", 
         SuperscriptBox[
          RowBox[{"kk", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "2"]}], 
        RowBox[{"4", " ", 
         SuperscriptBox["ks", "2"]}]]]}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"time", "-", 
     RowBox[{
     "independent", " ", "isocurvature", " ", "spectrum", " ", 
      "\"\<initial\>\""}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PR", "[", "j_", "]"}], ":=", 
     RowBox[{"2", " ", 
      SuperscriptBox["10", 
       RowBox[{"-", "9"}]], 
      RowBox[{"(", 
       RowBox[{"36", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"3", "+", 
           RowBox[{"Log", "[", 
            RowBox[{"0.15", " ", 
             FractionBox[
              RowBox[{"kk", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "keq"]}], "]"}], "-", 
           RowBox[{"Log", "[", 
            FractionBox["4", "y0"], "]"}]}], ")"}], "2"]}], ")"}]}]}], ";"}], 
   " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "the", " ", "initial", " ", "subhorizon", " ", "adiabatic", " ", 
     "spectrum"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dlnPdlny", "[", "j_", "]"}], ":=", 
     FractionBox["2", 
      RowBox[{"3", "+", 
       RowBox[{"Log", "[", 
        RowBox[{"0.15", " ", 
         FractionBox[
          RowBox[{"kk", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "keq"]}], "]"}], "-", 
       RowBox[{"Log", "[", 
        FractionBox["4", "y0"], "]"}]}]]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "log", " ", "y", " ", "derivative", " ", "of", " ", "the", " ", "initial",
      " ", "adiabatic", " ", "spectrum"}], " ", "*)"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   StyleBox[
    RowBox[{"(*", " ", "evolution", " ", "*)"}], "Subsection",
    FontSize->16], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PowerSpectra", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i0", ",", "PSY"}], "}"}], ",", 
         RowBox[{
          RowBox[{"i0", "=", 
           RowBox[{
            RowBox[{"Nearest", "[", 
             RowBox[{
              RowBox[{"midpts", "->", "\"\<Index\>\""}], ",", "Y"}], "]"}], 
            "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"PSY", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Ta", "=", 
                  RowBox[{"results", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", ",", "2"}], "]"}], "]"}]}], ",", 
                 RowBox[{"Tb", "=", 
                  RowBox[{"results", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", ",", "3"}], "]"}], "]"}]}], ",", 
                 RowBox[{"Tc", "=", 
                  RowBox[{"results", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", ",", "4"}], "]"}], "]"}]}]}], "}"}], ",", 
               " ", 
               RowBox[{"(*", " ", 
                RowBox[{"First", " ", 
                 SuperscriptBox["T", 
                  RowBox[{"(", 
                   RowBox[{"a", ",", "b", ",", "c"}], ")"}]], " ", "are", " ",
                  "extracted", " ", "from", " ", "results", " ", "and", " ", 
                 "then", " ", "the", " ", "PS", " ", "evolution", " ", "is", 
                 " ", "constructed"}], " ", "*)"}], 
               RowBox[{
                RowBox[{
                 RowBox[{"PisoIn", "[", "j", "]"}], 
                 RowBox[{"(", 
                  RowBox[{"1", "+", 
                   RowBox[{"3", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"dy", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ";;", 
                    RowBox[{"i0", "-", "1"}]}], "]"}], "]"}], ".", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Tc", "[", 
                    RowBox[{"[", 
                    RowBox[{"i0", ",", 
                    RowBox[{"1", ";;", 
                    RowBox[{"i0", "-", "1"}]}]}], "]"}], "]"}], "*", 
                    RowBox[{"Tb", "[", 
                    RowBox[{"[", 
                    RowBox[{"i0", ",", 
                    RowBox[{"1", ";;", 
                    RowBox[{"i0", "-", "1"}]}]}], "]"}], "]"}]}], ")"}]}], 
                    ")"}]}]}], ")"}]}], " ", 
                RowBox[{"(*", " ", 
                 RowBox[{"iso", " ", "PS", " ", "evolution"}], " ", "*)"}], 
                "\[IndentingNewLine]", "+", 
                RowBox[{
                 RowBox[{"PR", "[", "j", "]"}], 
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Ta", "[", 
                    RowBox[{"[", 
                    RowBox[{"i0", ",", "1"}], "]"}], "]"}], "+", 
                    RowBox[{
                    FractionBox["1", "2"], 
                    SqrtBox[
                    RowBox[{"1", "+", "y0"}]], " ", 
                    RowBox[{"dlnPdlny", "[", "j", "]"}], " ", 
                    RowBox[{"Tb", "[", 
                    RowBox[{"[", 
                    RowBox[{"i0", ",", "1"}], "]"}], "]"}]}]}], ")"}], 
                  "2"]}]}]}], 
              RowBox[{"(*", " ", 
               RowBox[{"ad", " ", "PS", " ", "evolution"}], " ", "*)"}], 
              "\[IndentingNewLine]", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"Length", "[", "results", "]"}]}], "}"}]}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"midpts", "[", 
             RowBox[{"[", "i0", "]"}], "]"}], ",", "PSY"}], "}"}]}]}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"Y", ",", "yout"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   StyleBox[
    RowBox[{"(*", " ", "plot", " ", "*)"}], "Subsection",
    FontSize->16], "\[IndentingNewLine]", 
   RowBox[{"TotalPS", "=", 
    RowBox[{"ListLogLogPlot", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"kk", ",", 
           RowBox[{"PowerSpectra", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"Length", "[", "yout", "]"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"Joined", "->", "True"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", " ", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
        "\"\<k[\!\(\*SuperscriptBox[\(Mpc\), \(-1\)]\)]\>\"", ",", 
         "\"\<\!\(\*SubscriptBox[SuperscriptBox[\(\[CapitalDelta]\), \(2\)], \
\(\[Delta]\)]\)(y,k)\>\""}], "}"}]}], ",", 
      RowBox[{"FrameStyle", "->", "15"}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         SuperscriptBox["10", 
          RowBox[{"-", "6.5"}]], ",", "10.5"}], "}"}]}], ",", 
      RowBox[{"ImageSize", "->", "500"}]}], "]"}], " "}]}]}]], "Input",
