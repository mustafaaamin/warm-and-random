Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"(*", 
    RowBox[{"~~", "~~", "~~", 
     RowBox[{
      RowBox[{"~", " ", "Power"}], " ", "Spectra", " ", "Assembly"}], " ", "~~",
      "~~", "~~", "~"}], "*)"}], "Subsection"], 
  StyleBox["\[IndentingNewLine]", "Subsection"], 
  RowBox[{"(*", 
   RowBox[{"Integration", " ", "weight", " ", 
    RowBox[{"dy", "/", 
     SqrtBox[
      RowBox[{"1", "+", "y"}]]}], " ", "evaluated", " ", "at", " ", 
    "midpoints"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dy", "=", 
     FractionBox[
      RowBox[{"r", "*", "midpts"}], 
      SqrtBox[
       RowBox[{"1", "+", "midpts"}]]]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"k", "-", 
     RowBox[{"list", " ", "extracted", " ", "from", " ", "results", " ", 
      RowBox[{"(", 
       RowBox[{
       "same", " ", "for", " ", "CDM", " ", "and", " ", "model", " ", "of", 
        " ", "interest"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kk", "=", 
     RowBox[{"resultsModel", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "The", " ", "primordial", " ", "curvature", " ", "spectrum", " ", 
     FractionBox[
      SuperscriptBox["k", "3"], 
      RowBox[{"2", 
       SuperscriptBox["\[Pi]", "2"]}]], 
     SubscriptBox["P", "R"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["y", "0"], ",", "k"}], ")"}], " ", "and", " ", "its", " ",
      "log", " ", "derivative", " ", "evaluated", " ", "on", " ", 
     "subhorizon", " ", "scales", " ", "at", " ", 
     SubscriptBox["y", "0"]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PR", "[", "j_", "]"}], ":=", 
     RowBox[{"2", " ", 
      SuperscriptBox["10", 
       RowBox[{"-", "9"}]], 
      RowBox[{"(", 
       RowBox[{"36", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"3", "+", 
           RowBox[{"Log", "[", 
            RowBox[{"0.15", " ", 
             FractionBox[
              RowBox[{"kk", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "keq"]}], "]"}], "-", 
           RowBox[{"Log", "[", 
            FractionBox["4", "y0"], "]"}]}], ")"}], "2"]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dlnPdlny", "[", "j_", "]"}], ":=", 
     FractionBox["2", 
      RowBox[{"3", "+", 
       RowBox[{"Log", "[", 
        RowBox[{"0.15", " ", 
         FractionBox[
          RowBox[{"klist", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "keq"]}], "]"}], "-", 
       RowBox[{"Log", "[", 
        FractionBox["4", "y0"], "]"}]}]]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Assemble", " ", "PS", " ", "at", " ", "a", " ", "given", " ", "output", 
     " ", "time", " ", "Y", " ", "from", " ", "a", " ", "results", " ", 
     RowBox[{"array", ".", " ", "Returns"}], " ", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"Piso", 
        RowBox[{"(", 
         RowBox[{"y", ",", "k"}], ")"}]}], ",", 
       RowBox[{"Pad", 
        RowBox[{"(", 
         RowBox[{"y", ",", "k"}], ")"}]}]}], "}"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"assemblePS", "[", 
     RowBox[{"sp_", ",", "res_", ",", "Y_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i0", ",", "PSiso", ",", "PSad"}], "}"}], ",", 
      RowBox[{
       RowBox[{"i0", "=", 
        RowBox[{
         RowBox[{"Nearest", "[", 
          RowBox[{
           RowBox[{"midpts", "->", "\"\<Index\>\""}], ",", "Y"}], "]"}], "[", 
         
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Isocurvature", ":", 
         RowBox[{
          FractionBox[
           SuperscriptBox["k", "3"], 
           RowBox[{"2", 
            SuperscriptBox["\[Pi]", "2"]}]], 
          SuperscriptBox["P", 
           RowBox[{"(", "iso", ")"}]], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["y", "0"], ",", "k"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"3", " ", 
             RowBox[{"\[Integral]", 
              RowBox[{
               RowBox[{
                RowBox[{"dy", "'"}], "/", "sqrt"}], 
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"y", "'"}]}], ")"}], " ", "Tb", 
               RowBox[{"(", 
                RowBox[{"y", ",", 
                 RowBox[{"y", "'"}]}], ")"}], " ", "Tc", 
               RowBox[{"(", 
                RowBox[{"y", ",", 
                 RowBox[{"y", "'"}]}], ")"}]}]}]}]}], ")"}]}]}], "*)"}], 
       RowBox[{"PSiso", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Tb", "=", 
               RowBox[{"res", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "3"}], "]"}], "]"}]}], ",", 
              RowBox[{"Tc", "=", 
               RowBox[{"res", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "4"}], "]"}], "]"}]}]}], "}"}], ",", 
            RowBox[{
             FractionBox[
              SuperscriptBox[
               RowBox[{"kk", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "3"], 
              RowBox[{"2", 
               SuperscriptBox["\[Pi]", "2"]}]], 
             RowBox[{"Piso", "[", 
              RowBox[{"sp", ",", 
               RowBox[{"klist", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "*", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"3", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"dy", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ";;", 
                    RowBox[{"i0", "-", "1"}]}], "]"}], "]"}], ".", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Tc", "[", 
                    RowBox[{"[", 
                    RowBox[{"i0", ",", 
                    RowBox[{"1", ";;", 
                    RowBox[{"i0", "-", "1"}]}]}], "]"}], "]"}], "*", 
                    RowBox[{"Tb", "[", 
                    RowBox[{"[", 
                    RowBox[{"i0", ",", 
                    RowBox[{"1", ";;", 
                    RowBox[{"i0", "-", "1"}]}]}], "]"}], "]"}]}], ")"}]}], 
                 ")"}]}]}], ")"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "res", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        SuperscriptBox[
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               SuperscriptBox["P", 
                RowBox[{"(", "ad", ")"}]], 
               RowBox[{"(", 
                RowBox[{"y", ",", "k"}], ")"}]}], "=", 
              RowBox[{
               FractionBox[
                SuperscriptBox["k", "3"], 
                RowBox[{"2", 
                 SuperscriptBox["\[Pi]", "2"]}]], 
               SubscriptBox["P", "R"], 
               RowBox[{"(", 
                RowBox[{
                 SubscriptBox["y", "0"], ",", "k"}], ")"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Ta", 
                  RowBox[{"(", 
                   RowBox[{"y", ",", 
                    SubscriptBox["y", "0"]}], ")"}]}], "+", 
                 RowBox[{
                  FractionBox["1", "2"], 
                  SqrtBox[
                   RowBox[{"1", "+", 
                    SubscriptBox["y", "0"]}]]}]}]}]}]}], "]"}], " ", 
            FractionBox[
             RowBox[{"d", " ", "ln", " ", "P"}], 
             RowBox[{"d", " ", "ln", " ", "y"}]], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["y", "0"], ",", "k"}], ")"}], "*", "Tb", 
            RowBox[{"(", 
             RowBox[{"y", ",", "y0"}], ")"}]}], "]"}], ")"}], "2"], "*)"}], 
       RowBox[{"PSad", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Ta", "=", 
               RowBox[{"res", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "2"}], "]"}], "]"}]}], ",", 
              RowBox[{"Tb", "=", 
               RowBox[{"res", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "3"}], "]"}], "]"}]}]}], "}"}], ",", 
            RowBox[{
             RowBox[{"PR", "[", "j", "]"}], "*", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Ta", "[", 
                 RowBox[{"[", 
                  RowBox[{"i0", ",", "1"}], "]"}], "]"}], "+", 
                RowBox[{
                 FractionBox["1", "2"], 
                 SqrtBox[
                  RowBox[{"1", "+", "y0"}]], " ", 
                 RowBox[{"dlnPdlny", "[", "j", "]"}], "*", 
                 RowBox[{"Tb", "[", 
                  RowBox[{"[", 
                   RowBox[{"i0", ",", "1"}], "]"}], "]"}]}]}], ")"}], 
              "2"]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "res", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"midpts", "[", 
          RowBox[{"[", "i0", "]"}], "]"}], ",", "PSiso", ",", "PSad"}], 
        "}"}]}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.982671620658182*^9, 3.982671620659226*^9}, {
