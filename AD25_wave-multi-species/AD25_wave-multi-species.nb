Cell[BoxData[
 RowBox[{
  StyleBox[" ", "Subsection"], 
  StyleBox[
   RowBox[{"(*", 
    RowBox[{"~~", "~~", 
     RowBox[{
      RowBox[{"~", " ", "k"}], "-", 
      RowBox[{"independent", " ", "grid"}]}], " ", "~~", "~~"}], "*)"}], 
   "Subsection"], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Log", "-", 
     RowBox[{"spaced", " ", "y"}], "-", 
     RowBox[{
     "grid", " ", "and", " ", "geometric", " ", "midpoints", " ", "m_i"}]}], 
    "=", 
    RowBox[{"sqrt", 
     RowBox[{"(", 
      RowBox[{"y_i", "*", "y_", 
       RowBox[{"{", 
        RowBox[{"i", "+", "1"}], "}"}]}], ")"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ygrid", "=", 
     RowBox[{"Exp", "@", 
      RowBox[{"Subdivide", "[", 
       RowBox[{
        RowBox[{"Log", "[", "y0", "]"}], ",", 
        RowBox[{"Log", "[", "yf", "]"}], ",", 
        RowBox[{"Ny", "-", "1"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"midpts", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"Most", "[", "ygrid", "]"}], "*", 
       RowBox[{"Rest", "[", "ygrid", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Nmid", "=", 
     RowBox[{"Length", "[", "midpts", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", "-", 
      RowBox[{"size", " ", 
       RowBox[{"factor", ":", 
        RowBox[{
         RowBox[{"y_", 
          RowBox[{"{", 
           RowBox[{"i", "+", "1"}], "}"}]}], "-", "y_i"}]}]}]}], "=", 
     RowBox[{"y_i", "*", "r", "  ", 
      RowBox[{"(", 
       RowBox[{"exact", " ", "for", " ", "log", " ", "spacing"}], ")"}]}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"r", "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"ygrid", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "/", 
        RowBox[{"ygrid", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "-", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"ygrid", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "/", 
        RowBox[{"ygrid", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Log", "-", 
     RowBox[{"spaced", " ", "k"}], "-", "grid"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"klist", "=", 
     RowBox[{"Exp", "@", 
      RowBox[{"Subdivide", "[", 
       RowBox[{
        RowBox[{"Log", "[", "kmin", "]"}], ",", 
        RowBox[{"Log", "[", "kmax", "]"}], ",", 
        RowBox[{"Nk", "-", "1"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"k", "-", 
     RowBox[{"independent", " ", "matrices", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"computed", " ", "once"}], ",", 
        RowBox[{"reused", " ", "for", " ", "every", " ", "k"}]}], ")"}]}]}], 
    "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"F", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
     RowBox[{"F", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m_i", ",", "m_j"}], ")"}], " ", "--"}], " ", "comoving", " ",
       "distance", " ", "function"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F", "=", 
     RowBox[{"Outer", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{
          FractionBox["#1", "#2"], " ", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              SqrtBox[
               RowBox[{"1", "+", "#2"}]]}], ")"}], "2"], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              SqrtBox[
               RowBox[{"1", "+", "#1"}]]}], ")"}], "2"]]}], "]"}], "&"}], ",",
        "midpts", ",", "midpts"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "distance", " ", "function", " ", "as", " ", "a", " ", "matrix", " ", 
     "of", " ", "y", " ", "and", " ", 
     RowBox[{"y", "'"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"DY", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"dy", "'"}], "/", 
        SqrtBox[
         RowBox[{"1", "+", 
          RowBox[{"y", "'"}]}]]}], " ", "evaluated", " ", "at", " ", 
       RowBox[{"y", "'"}]}], "=", 
      RowBox[{"m_j", ":", 
       RowBox[{"integration", " ", "measure"}]}]}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DY", "=", 
     RowBox[{"Outer", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#2", " ", "r"}], ")"}], "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "+", "#2"}], "]"}]}], "&"}], ",", "midpts", ",", 
       "midpts"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "integration", " ", "measure", " ", "as", " ", "a", " ", "vector"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Causal", " ", 
     RowBox[{"mask", ":", 
      RowBox[{
       RowBox[{"enforce", " ", "y"}], ">", 
       RowBox[{
        RowBox[{"y", "'"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"lower", " ", "triangular"}], ",", 
          RowBox[{"diagonal", " ", "excluded"}]}], ")"}]}]}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mask", "=", 
     RowBox[{"LowerTriangularize", "[", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{"1.", ",", 
         RowBox[{"{", 
          RowBox[{"Nmid", ",", "Nmid"}], "}"}]}], "]"}], ",", 
       RowBox[{"-", "1"}]}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"y", ">", 
     RowBox[{"y", "'"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   StyleBox["\[IndentingNewLine]", "Subsection"], 
   StyleBox[
    RowBox[{"(*", 
     RowBox[{"~~", "~~", 
      RowBox[{
       RowBox[{"~", " ", "main"}], " ", "module"}], " ", "~~", "~~", "~~"}], 
     "*)"}], "Subsection"], "\[IndentingNewLine]", 
   RowBox[{"ClearAll", "[", 
    RowBox[{"computeT", ",", "Piso"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Piso", "[", 
       RowBox[{"sp", ",", "k"}], "]"}], ":", 
      RowBox[{"initial", " ", "isocurvature", " ", "power", " ", 
       RowBox[{"spectrum", ".", " ", "For"}], " ", "Gaussian", " ", 
       SubscriptBox[
        SuperscriptBox["f", "s"], "0"], 
       RowBox[{"(", "p", ")"}]}]}], ",", " ", 
     RowBox[{"we", " ", "have", " ", 
      SubscriptBox["P", "iso"], " ", "for", " ", "each", " ", "species", " ", 
      "being", " ", 
      SuperscriptBox[
       SubscriptBox["f", "s"], "2"], 
      FractionBox[
       SuperscriptBox["\[Pi]", 
        RowBox[{"3", "/", "2"}]], 
       SuperscriptBox[
        SubscriptBox["k", "s"], "3"]], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox["k", "2"], 
         RowBox[{"4", 
          SuperscriptBox[
           SubscriptBox["k", "s"], "2"]}]]}]]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Piso", "[", 
     RowBox[{"sp_", ",", "k_"}], "]"}], ":=", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{
          SuperscriptBox["\[Pi]", 
           RowBox[{"3", "/", "2"}]], 
          SuperscriptBox[
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "2"]}], 
         SuperscriptBox[
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "3"]], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"-", 
          FractionBox[
           SuperscriptBox["k", "2"], 
           RowBox[{"4", 
            SuperscriptBox[
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "2"]}]]}]]}], "  ", "&"}], "/@",
       "sp"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"computeT", "[", 
       RowBox[{"sp", ",", "k", ",", "Nit", ",", "F", ",", "DY", ",", "mask"}],
        "]"}], ".", " ", "Solves"}], " ", "the", " ", "Volterra", " ", 
     "equations", " ", 
     RowBox[{"(", "2.12", ")"}], " ", "for", " ", 
     RowBox[{"T", "^", 
      RowBox[{"(", 
       RowBox[{"a", ",", "b", ",", "c"}], ")"}]}], "_k", " ", "by", " ", 
     RowBox[{"Picard", ".", " ", "Iteration"}], " ", "returns", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k", ",", "Ta", ",", "Tb", ",", "Tc"}], "}"}], "."}]}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{"Picard", " ", "iteration", " ", 
     RowBox[{"step", ":", 
      RowBox[{
       SuperscriptBox["T", 
        RowBox[{"(", "i", ")"}]], "<", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["Tfs", 
          RowBox[{"(", "i", ")"}]]}], "+", 
        RowBox[{
         RowBox[{"KK", ".", 
          SuperscriptBox["T", 
           RowBox[{"(", "i", ")"}]]}], "   ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"i", "=", "a"}], ",", "b", ",", "c"}], ")"}]}]}]}]}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"computeT", "[", 
     RowBox[{
     "sp_", ",", "k_", ",", "Nit_", ",", "F_", ",", "DY_", ",", "mask_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "piso", ",", "Tfsa", ",", "Tfsb", ",", "Tfsc", ",", "KK", ",", "Ta", 
        ",", "Tb", ",", "Tc"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"~~", "~~", "~~", "~~", 
        RowBox[{
         RowBox[{"~", "Free"}], "-", 
         RowBox[{"streaming", " ", "Kernels"}]}], " ", "~~", "~~", "~~", 
        "~~"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"piso", "=", 
        RowBox[{"Piso", "[", 
         RowBox[{"sp", ",", "k"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "These", " ", "a", " ", "are", " ", "density", " ", "fraction", " ", 
         SubscriptBox["f", 
          RowBox[{"i", " "}]], "weighted", " ", "sums", " ", "of", " ", 
         "single", " ", "species", " ", "kernels"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Note", " ", "that", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "->", 
          SubscriptBox["f", "s"]}], ",", " ", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "->", " ", 
          RowBox[{
           RowBox[{
            SubscriptBox["m", "s"], " ", "and", " ", 
