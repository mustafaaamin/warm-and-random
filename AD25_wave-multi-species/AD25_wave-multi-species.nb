            RowBox[{"2", "i"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"-", "20"}], ",", "15"}], "}"}]}], "]"}]}], ";"}], "\n", 
    RowBox[{
     RowBox[{"unlabeledTicks", "=", 
