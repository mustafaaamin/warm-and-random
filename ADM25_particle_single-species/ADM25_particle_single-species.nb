      RowBox[{
       RowBox[{"Tfsa", "=", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            SuperscriptBox[
             RowBox[{"(", 
              FractionBox["k", "keq"], ")"}], "2"]}], 
           SuperscriptBox["\[Sigma]eq", "2"], 
           SuperscriptBox["F", "2"]}], "]"}], "*", "mask"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Tfsb", "=", 
        RowBox[{"F", "*", 
         RowBox[{"(", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox["k", "keq"], ")"}], "2"]}], 
            SuperscriptBox["\[Sigma]eq", "2"], " ", 
            SuperscriptBox["F", "2"]}], "]"}], ")"}], "*", "mask"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Tfsc", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox["k", "keq"], ")"}], "2"]}], 
