Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"(*", 
    RowBox[{"~~", "~~", "~~", 
     RowBox[{"~", " ", "Adiabatic"}], " ", "~~", "~~", "~~", "~"}], "*)"}], 
   "Subsection"], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PR", "[", "j_", "]"}], ":=", 
     RowBox[{"2", " ", 
      SuperscriptBox["10", 
       RowBox[{"-", "9"}]], 
      RowBox[{"(", 
       RowBox[{"36", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"3", "+", 
           RowBox[{"Log", "[", 
            RowBox[{"0.15", " ", 
             FractionBox[
              RowBox[{"klist", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "keq"]}], "]"}], "-", 
           RowBox[{"Log", "[", 
            FractionBox["4", "y0"], "]"}]}], ")"}], "2"]}], ")"}]}]}], ";"}], 
   " ", 
   RowBox[{"(*", " ", 
    RowBox[{"the", " ", "initial", " ", "subhorizon", " ", "spectrum"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dlnPdlny", "[", "j_", "]"}], ":=", 
     FractionBox["2", 
      RowBox[{"3", "+", 
       RowBox[{"Log", "[", 
        RowBox[{"0.15", " ", 
         FractionBox[
          RowBox[{"klist", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "keq"]}], "]"}], "-", 
       RowBox[{"Log", "[", 
        FractionBox["4", "y0"], "]"}]}]]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "log", " ", "y", " ", "derivative", " ", "of", " ", "the", " ", "initial",
      " ", "spectrum"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", 
     SubscriptBox["P", "\[Delta]"], 
     RowBox[{"(", "k", ")"}], " ", "for", " ", "each", " ", "y"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PowerSpectraA", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"i0", ",", "PSYA"}], "}"}], ",", 
         RowBox[{
          RowBox[{"i0", "=", 
           RowBox[{
            RowBox[{"Nearest", "[", 
             RowBox[{
              RowBox[{"midpts", "->", "\"\<Index\>\""}], ",", "Y"}], "]"}], 
            "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"PSYA", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Ta", "=", 
                  RowBox[{"results", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", ",", "2"}], "]"}], "]"}]}], ",", 
                 RowBox[{"Tb", "=", 
                  RowBox[{"results", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", ",", "3"}], "]"}], "]"}]}]}], "}"}], ",", 
               RowBox[{
                RowBox[{"PR", "[", "j", "]"}], 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Ta", "[", 
                    RowBox[{"[", 
                    RowBox[{"i0", ",", "1"}], "]"}], "]"}], "+", 
                   RowBox[{
                    FractionBox["1", "2"], 
                    SqrtBox[
                    RowBox[{"1", "+", "y0"}]], " ", 
                    RowBox[{"dlnPdlny", "[", "j", "]"}], " ", 
                    RowBox[{"Tb", "[", 
                    RowBox[{"[", 
                    RowBox[{"i0", ",", "1"}], "]"}], "]"}]}]}], ")"}], 
                 "2"]}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"Length", "[", "results", "]"}]}], "}"}]}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"midpts", "[", 
             RowBox[{"[", "i0", "]"}], "]"}], ",", "PSYA"}], "}"}]}]}], "]"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"Y", ",", "yout"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "alpha", " ", "list"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"kk", "=", 
