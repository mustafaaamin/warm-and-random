   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F", "=", 
     RowBox[{"Outer", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{
          FractionBox["#1", "#2"], " ", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              SqrtBox[
               RowBox[{"1", "+", "#2"}]]}], ")"}], "2"], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              SqrtBox[
               RowBox[{"1", "+", "#1"}]]}], ")"}], "2"]]}], "]"}], "&"}], ",",
        "midpts", ",", "midpts"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "distance", " ", "function", " ", "as", " ", "a", " ", "matrix", " ", 
     "of", " ", "y", " ", "and", " ", 
