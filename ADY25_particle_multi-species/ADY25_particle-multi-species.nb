       SqrtBox[
        RowBox[{
         RowBox[{"ygrid", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "/", 
         RowBox[{"ygrid", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]]}], ")"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"r", " ", "=", " ", 
     RowBox[{
      SqrtBox[
       RowBox[{
        SubscriptBox["y", 
         RowBox[{"i", "+", "1"}]], "/", 
        SubscriptBox["y", "i"]}]], "-", 
      SqrtBox[
       RowBox[{
        SubscriptBox["y", "i"], "/", 
        SubscriptBox["y", 
         RowBox[{"i", "+", "1"}]]}]]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"midpts", "=", 
     SqrtBox[
