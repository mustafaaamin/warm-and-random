        RowBox[{"Nk", "-", "1"}]}], "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"\[Alpha]", "-", "grid"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Precompute", " ", "k"}], "-", 
