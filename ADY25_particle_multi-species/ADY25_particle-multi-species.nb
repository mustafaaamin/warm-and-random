        RowBox[{"Log", "[", "y", "]"}], ",", 
        RowBox[{"Ny", "-", "1"}]}], "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"log", "-", 
     RowBox[{"spaced", " ", "y"}], "-", "grid"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"r", "=", 
